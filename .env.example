# 复制本文件为 .env 并填入你自己的真实值（.env 已被 gitignore，不会提交）

# OpenAI 兼容接口（阿里百炼 / 通义等走 OpenAI 兼容 API 时填写）
OPENAI_API_KEY=your-openai-compatible-api-key
BASE_URL=https://your-base-url/v1

# Ollama 本地模型
OLLAMA_BASE_URL=http://localhost:11434

# Redis（按需填写）
REDIS_URL=redis://localhost:6379/0
REDIS_STACK_URL=redis://localhost:6380/0
REDIS_FORCE_SAVE=false

# 通义千问（阿里云）
aliQwen-api=your-qwen-api-key

# OpenWeather 天气服务
OPENWEATHER_API_KEY=your-openweather-api-key
